# Configurar en el servidor. Nunca incluir este archivo con valores en un APK.
JARVIS_OPENAI_API_KEY=
# Nombre alternativo para descartar conflictos del gestor de secretos; tiene prioridad si contiene valor.
JARVIS_OPENAI_API_KEY_2=
JARVIS_MODEL=gpt-6-astra
JARVIS_REASONING_EFFORT=medium
JARVIS_MAX_OUTPUT_TOKENS=2048
JARVIS_TASK_TOKEN_LIMIT=32000
JARVIS_DAILY_TOKEN_LIMIT=100000
JARVIS_MAX_STEPS=12
JARVIS_TIMEZONE=America/Argentina/Buenos_Aires
# Directorio persistente fuera de la instalación (opcional).
JARVIS_DATA_DIR=
# Windows local: ruta al ejecutor publicado. Sin valor: capacidad no disponible.
JARVIS_WINDOWS_EXECUTOR=
# Host MCP propio, versión fijada en package-lock.json. Activación optativa.
JARVIS_MCP_ENABLED=false
JARVIS_MCP_HEADLESS=false
# Proveedor alternativo, seleccionado explícitamente:
JARVIS_PROVIDER=openai
JARVIS_GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=
